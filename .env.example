# AI Generation (choose either local Gemma via Ollama or Google Gemini API)
# Option 1: Free local Ollama with Gemma 4 (default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e4b

# Option 2: Google Gemini API (hosted multimodal vision)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase (optional, for accounts, saving projects & public shares)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
