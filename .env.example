# AI Generation (Google Gemini API by default; Ollama is available as a local alternative)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Free local Ollama with Gemma
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma3n:e2b

# Supabase (optional, for accounts, saving projects & public shares)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
